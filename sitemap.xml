<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://miradesconto.github.io/miradesconto/</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://miradesconto.github.io/miradesconto/blog/</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url><loc>https://miradesconto.github.io/miradesconto/sobre.html</loc></url>
  <url><loc>https://miradesconto.github.io/miradesconto/transparencia.html</loc></url>
  <url><loc>https://miradesconto.github.io/miradesconto/privacidade.html</loc></url>
{% for entry in site.artigos %}{% assign words = entry.content | markdownify | strip_html | strip %}{% if entry.status == 'publicado' and words != '' %}<url><loc>{{ entry.url | absolute_url | xml_escape }}</loc>{% if entry.atualizado and entry.atualizado != '' %}<lastmod>{{ entry.atualizado | date: "%Y-%m-%d" }}</lastmod>{% elsif entry.data and entry.data != '' %}<lastmod>{{ entry.data | date: "%Y-%m-%d" }}</lastmod>{% endif %}</url>{% endif %}{% endfor %}
</urlset>
